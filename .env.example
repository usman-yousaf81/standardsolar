# ===================================================================
# Standard Solar — environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Project Settings → API
#
# Leave these blank and the site still runs: every page falls back to
# the static content in src/content/site.ts. The admin portal is the
# only thing that needs a real connection.
# ===================================================================

# Safe to expose — the browser needs both of these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Never prefix with
# NEXT_PUBLIC_, never commit it, and never import it into a client
# component. Only needed if a task has to run without a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# The public origin, used for absolute URLs in metadata.
# e.g. https://standardsolar.com.pk
NEXT_PUBLIC_SITE_URL=
